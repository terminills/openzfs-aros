+BYTE ata_FlushCache(struct ata_Unit *unit)
+{
+    ata_CommandBlock acb = {0};
+    UWORD commands;
+
+    /* CMD_UPDATE is queued on the bus task, just like reads and writes.
+     * Never acknowledge stable storage without a completed device command.
+     * ATAPI requires a separate SYNCHRONIZE CACHE packet implementation. */
+    if (!unit->au_Drive || (unit->au_Bus->ab_Dev[unit->au_UnitNum & 1] & 0x80))
+        return IOERR_NOCMD;
+    commands = unit->au_Drive->id_Commands2;
+    if ((commands & 0xc000) != 0x4000)
+        return IOERR_NOCMD;
+    if (commands & (1 << 13))
+        acb.command = ATA_FLUSH_CACHE_EXT;
+    else if (commands & (1 << 12))
+        acb.command = ATA_FLUSH_CACHE;
+    else
+        return IOERR_NOCMD;
+    acb.method = CM_NoData;
+    acb.type = CT_NoBlock;
+    return ata_exec_cmd(unit, &acb);
+}
