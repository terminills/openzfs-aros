+static BYTE ahci_scsi_inquiry(struct ata_port *at, struct SCSICmd *scsi)
+{
+    const UBYTE *cmd = scsi->scsi_Command;
+    UBYTE reply[96] = {0};
+    ULONG length, allocation, start, end;
+
+    scsi->scsi_Actual = 0;
+    scsi->scsi_CmdActual = 0;
+    scsi->scsi_Status = 0;
+    scsi->scsi_SenseActual = 0;
+    if (scsi->scsi_CmdLength != 6)
+        return IOERR_BADLENGTH;
+    if ((cmd[1] & ~1) || cmd[5])
+        return IOERR_NOCMD;
+    allocation = ((ULONG)cmd[3] << 8) | cmd[4];
+    if (cmd[1] & 1) {
+        reply[1] = cmd[2];
+        switch (cmd[2]) {
+        case SVPD_SUPPORTED_PAGE_LIST:
+            reply[3] = 2;
+            reply[4] = SVPD_SUPPORTED_PAGE_LIST;
+            reply[5] = SVPD_UNIT_SERIAL_NUMBER;
+            length = 6;
+            break;
+        case SVPD_UNIT_SERIAL_NUMBER:
+            start = 0;
+            end = sizeof(at->at_identify.serial);
+            while (start < end && at->at_identify.serial[start] == ' ') ++start;
+            while (end > start && at->at_identify.serial[end - 1] == ' ') --end;
+            reply[3] = end - start;
+            CopyMem(at->at_identify.serial + start, reply + 4, end - start);
+            length = 4 + end - start;
+            break;
+        default:
+            return IOERR_NOCMD;
+        }
+    } else {
+        if (cmd[2]) return IOERR_NOCMD;
+        reply[0] = T_DIRECT;
+        reply[1] = (le16toh(at->at_identify.config) & 0x80) ? 0x80 : 0;
+        reply[2] = SCSI_REV_SPC2;
+        reply[3] = 2;
+        reply[4] = 31;
+        CopyMem("SATA    ", reply + 8, 8);
+        CopyMem(at->at_identify.model, reply + 16, 16);
+        CopyMem(at->at_identify.firmware, reply + 32, 4);
+        length = 36;
+    }
+    if (length > allocation) length = allocation;
+    if (!(scsi->scsi_Flags & SCSIF_READ) || scsi->scsi_Length < length ||
+        (length && !scsi->scsi_Data))
+        return IOERR_BADLENGTH;
+    if (length) CopyMem(reply, scsi->scsi_Data, length);
+    scsi->scsi_Actual = length;
+    scsi->scsi_CmdActual = scsi->scsi_CmdLength;
+    return 0;
+}
