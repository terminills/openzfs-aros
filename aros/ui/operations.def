/* Stable operation IDs: append only; protocol version 1. */
OZ_OP(1, "Service", "service.hello", "hello", 0, "", "", "Connect to the native management service.")
OZ_OP(2, "Service", "service.capabilities", "capabilities", 0, "", "", "Query supported operations; catalogue visibility is not support.")
OZ_OP(3, "Pools", "pool.list", "list", 0, "Optional pool name", "", "List imported pools, optionally matching one exact name. Blank lists all; unmatched names return no rows. Raw size, allocated and free bytes are not dataset available space. Live pages; statistics failures are explicit. No options.")
OZ_OP(4, "Pools", "pool.status", "status", 0, "Pool name", "", "Read imported pool/device health and error counters from upstream statistics.")
OZ_OP(82, "Pools", "pool.errors", "error details", 0, "Pool name", "", "Read upstream zpool status -v, including affected file paths where available. No flags, arguments or options. Detailed error records require upstream privilege. Output over 4 KiB is retained in the named temporary report; copy it before reboot. This does not clear errors or repair data.")
OZ_OP(5, "Pools", "pool.create", "create", 1, "Permanent pool name", "", "Root: Pool builder with blank exclusive files or explicit native partitions. Optional tname=temporary sets the live name until export; disk labels retain the permanent name. No partition edits, force or dry-run. Exclude other writers.")
OZ_OP(6, "Pools", "pool.destroy", "destroy", 1, "Pool name", "", "Root: unmount first. Destroys the pool. Confirm; no force or options. Not a secure data erase.")
OZ_OP(7, "Pools", "pool.import", "import", 1, "Pool name", "Configuration file", "Explicit backing paths: native /AROS/device/unit[/partition/slot] or files, with readonly=on/off. Read/write import may update storage and requires writable admission. destroyed=on selects destroyed pools; rewind=on selects checkpoint state. Writable rewind discards later changes. Confirm; no force/dry-run.")
OZ_OP(8, "Pools", "pool.export", "export", 1, "Pool", "", "Authenticated root export; unmount datasets first. Confirmation required; no force, arguments or options.")
OZ_OP(9, "Pools", "pool.add", "add", 1, "Pool name", "", "Root: Pool builder lists NEW groups only, using blank pre-provisioned files or explicit native partitions. Adds capacity/log/cache/spares; not attach. Confirm; no force/options/dry-run. Match pool ashift and exclude other raw writers.")
OZ_OP(10, "Pools", "pool.remove", "remove", 1, "Pool", "GUID / cancel", "Remove by GUID, or cancel active data evacuation. Root required; no options. Query status afterward.")
OZ_OP(11, "Pools", "pool.attach", "attach", 1, "Pool name", "Existing GUID", "Root: attach a blank pre-provisioned file or native partition to the exact device GUID. Enter New backing path; exclude other raw writers. Sequential requests rebuild=on and requires device_rebuild plus an upstream-supported topology. No force/dry-run. Inspect rebuild/resilver status; sequential reconstruction does not verify checksums, so scrub afterward.")
OZ_OP(12, "Pools", "pool.detach", "detach", 1, "Pool name", "Leaf GUID", "Root: detach the exact leaf GUID from status. Reduces redundancy; upstream refuses unsafe or unsupported topology. No force/options/dry-run. Query status afterward.")
OZ_OP(13, "Pools", "pool.replace", "replace", 1, "Pool name", "Existing GUID", "Root: replace the exact device GUID with a blank pre-provisioned file/native partition or an existing dRAID spare name from pool status. A spare must belong to the same dRAID group. Sequential requests rebuild=on and requires device_rebuild plus an upstream-supported topology. No force/dry-run. Inspect rebuild/resilver status; sequential reconstruction does not verify checksums, so scrub afterward.")
OZ_OP(14, "Pools", "pool.split", "split", 1, "Source pool", "New pool name", "Root: unmount first. Options: guids=leaf,leaf (one from every mirror). Reduces source redundancy. Destination stays exported. No force/dry-run.")
OZ_OP(15, "Pools", "pool.online", "online", 1, "Pool name", "Device GUID", "Authenticated root; exact decimal leaf GUID from status. Optional expand=on; check resulting capacity/status. Online acceptance is not resilver completion.")
OZ_OP(16, "Pools", "pool.offline", "offline", 1, "Pool name", "Device GUID", "Authenticated root; exact decimal leaf GUID from status. Optional temporary=on until export/reimport. Upstream protects required redundancy.")
OZ_OP(17, "Pools", "pool.clear", "clear", 1, "Pool name", "Optional device GUID", "Root: clear pool errors, or one decimal device GUID from status. Attempts to resume suspended I/O. No rewind, force, options or dry-run. Query health afterward; clearing errors does not prove repaired data.")
OZ_OP(18, "Pools", "pool.scrub", "scrub", 1, "Pool name", "Action", "Authenticated root: start, pause, resume or stop. Confirm; no options/dry-run. Success accepts control; query pool.status for completion.")
OZ_OP(19, "Pools", "pool.resilver", "resilver", 1, "Pool name", "", "Root: restart resilver, including deferred repairs. Requires resilver_defer. Healthy pools may have nothing to repair. Query status for actual progress/completion. Confirm; no arguments/options/force/dry-run.")
OZ_OP(20, "Pools", "pool.initialize", "initialize", 1, "Pool name", "start/suspend/cancel/uninitialize", "Root: options guids=leaf,leaf. Initialize unused space, not format or secure erase. Start also resumes. Uninitialize clears progress metadata. Query status; acceptance is not completion. Partial per-device errors are possible. No force/dry-run.")
OZ_OP(21, "Pools", "pool.trim", "trim", 1, "Pool name", "start/suspend/cancel", "Root: guids=leaf,leaf;rate=bytes-per-second;partial=on|off;secure=on|off. Start also resumes. Requires real discard support; current AROS file/device backend reports unsupported. Per-device errors may be partial. No force/dry-run.")
OZ_OP(22, "Pools", "pool.checkpoint", "checkpoint", 1, "Pool name", "create or discard", "Root: create or discard an upstream checkpoint. Requires enabled zpool_checkpoint feature. Confirm; no options/force/dry-run. Discard success accepts background reclamation; query pool.status. Import rewind=on selects checkpoint state.")
OZ_OP(23, "Pools", "pool.reguid", "reguid", 1, "Pool name", "Optional decimal GUID", "Root: change pool GUID; blank generates one upstream. All devices must be healthy. Confirm; no options/force/dry-run. Existing GUIDs and checkpoint conflicts are refused upstream.")
OZ_OP(24, "Pools", "pool.reopen", "reopen", 1, "Pool name", "", "Root: reopen devices of one imported pool. Optional scrub_restart=off preserves an active scrub; default on. Query status for device health afterward. Confirm; no force/arguments/dry-run.")
OZ_OP(25, "Pools", "pool.upgrade", "upgrade", 1, "Pool name", "", "Irreversible pool format/feature upgrade. Older software may lose access. Empty options enable supported compatible features; version=1..28 or 5000 selects format. Root and confirmation required; no force/dry-run. Not a dataset version upgrade.")
OZ_OP(26, "Pools", "pool.sync", "sync", 1, "Pool name", "", "Wait for the open transaction group to commit. Mounted datasets allowed. Force also updates clean labels/configuration. Confirm; no arguments/options/dry-run. Read-only or suspended pools refused.")
OZ_OP(27, "Pools", "pool.prefetch", "prefetch", 1, "Pool name", "", "Load upstream DDT/BRT metadata into cache. Options: type=ddt or type=brt; empty selects both. Root required. Confirm; no force/dry-run. No performance guarantee.")
OZ_OP(28, "Pools", "pool.ddtprune", "ddtprune", 1, "Pool name", "", "Prune single-reference dedup entries, not files. Requires fast_dedup and root. Options: percent=1..100 or days=positive-decimal. Confirm; no force/dry-run. Runs asynchronously; close waits for completion.")
OZ_OP(29, "Pools", "pool.labelclear", "labelclear", 1, "Vdev path", "", "Erase ZFS labels, not data securely. Confirm exact file or /AROS/device/unit[/partition/position] path. Force allows exported or potentially-active pools, never a currently imported member. Native writes require root, an unclaimed DOS unit and the resident write-capable service. No dry-run or options.")
OZ_OP(30, "Pools", "pool.wait", "wait", 0, "Pool name", "", "Wait for upstream activity to stop; not a health guarantee. Options: activities=scrub,resilver (or discard,free,initialize,replace,remove,trim,raidz_expand). Empty waits for all. No flags. Close waits for completion; no cancellation yet.")
OZ_OP(31, "Pools", "pool.get", "get", 0, "Pool name", "Property name", "Read one exact upstream pool property, or all with live pagination. Numeric values use raw upstream units; property-long rows require an exact query. No options or recursion.")
OZ_OP(32, "Pools", "pool.set", "set", 1, "Pool name", "property=value", "Root: pool policy/user properties or feature@name=enabled. Feature enablement is irreversible and can reduce compatibility; it does not establish AROS support for every related facility. Confirm; no options/force/dry-run.")
OZ_OP(33, "Pools", "pool.history", "history", 0, "Pool name", "", "Root-authenticated upstream history. Next page uses byte offsets. Summaries may abbreviate; Raw returns complete stream bytes as hex. Live history, not a frozen snapshot.")
OZ_OP(34, "Pools", "pool.events", "events", 0, "Optional pool filter", "", "Read queued upstream events. Options: verbose=on; scripted=on. Or clear=on with confirmation and no filter/other options. CLI zpool events -f follows new events; this window returns the current queue.")
OZ_OP(35, "Pools", "pool.iostat", "iostat", 0, "Pool name", "", "Live upstream byte/operation totals. Options: histogram=latency (nanoseconds) or histogram=size (bytes). Histograms are cumulative, not rates. Next page continues metrics/topology; pages are live, not a frozen snapshot. Inactive devices report unavailable.")
OZ_OP(36, "Datasets", "dataset.list", "list", 0, "Root dataset", "", "List a dataset; Recursive includes descendants. Options: snapshots=on. Alternatively bookmarks=on lists one filesystem's bookmarks, without recursion.")
OZ_OP(37, "Datasets", "dataset.create", "create", 1, "New dataset / volume", "", "Comma-separated options: filesystem defaults, or type=volume,volsize=2G,volblocksize=8K. Both accept reservation/refreservation; filesystems also quota/refquota/recordsize, normalization, utf8only, casesensitivity. Sizes accept K/M/G; quota/reservations accept none. Encryption: encryption=on,keyformat=raw (or hex/passphrase), native key-file path in Argument; optional pbkdf2iters (minimum 100000). No secret text. Confirm; no dry-run.")
OZ_OP(38, "Datasets", "dataset.destroy", "destroy", 1, "Dataset/snapshot/bookmark", "", "Destroy one unmounted dataset or snapshot, or one dataset#bookmark; dependencies checked upstream. Recursive snapshot destruction is atomic. Recursive dataset destruction requires a snapshot-free unmounted tree, preflights delegated rights, then destroys deepest-first; a runtime failure may leave partial progress reported in detail. A held snapshot accepts defer=on and is removed after its last hold is released. Authenticated bookmarks require destroy, not mount. Confirm; no force/dry-run/recursive defer.")
OZ_OP(39, "Datasets", "dataset.rename", "rename", 1, "Dataset or snapshot", "Destination name", "Rename an unmounted dataset within its pool, or snapshots within their filesystem. Recursive applies to snapshots only. Idle snapshot volumes detach; busy references refuse the request. Confirm; no force, options or dry-run.")
OZ_OP(40, "Datasets", "dataset.get", "get", 0, "Dataset / zvol", "Property name", "Read one exact upstream dataset property, or all with live pagination. Recursive exact-property and all-property views use one global live cursor across descendants. property-long rows require an exact query. No options.")
OZ_OP(41, "Datasets", "dataset.set", "set", 1, "Dataset or snapshot", "property=value", "Set properties, numeric user/group/project quota@ID or objquota@ID, and six default quotas. Upstream delegation/features required. Sync=disabled sacrifices durability. Use none to clear a limit; per-ID quotas cannot inherit. Zvol shrinking discards data: unmount first. Confirm; no options/dry-run.")
OZ_OP(42, "Datasets", "dataset.inherit", "inherit", 1, "Dataset or snapshot", "property name", "Inherit a supported property from its parent. Recursive applies the upstream inherit operation to the selected dataset and descendants, skips descendant types where a built-in is invalid, and reports completed count if a later failure leaves partial progress. Set received=on to remove local overrides and restore received values, if any (zfs inherit -S). Delegation required. Sync=disabled sacrifices durability. Confirm; no force/dry-run.")
OZ_OP(43, "Datasets", "dataset.mount", "mount", 1, "Dataset", "DOS name (no colon)", "MuFS-authenticated AROS mount: readonly=on or readonly=off required. Confirm, disable dry-run. Mount permission required; service stays resident.")
OZ_OP(44, "Datasets", "dataset.unmount", "unmount", 1, "Dataset", "", "Detach AROS mount; close files/locks first. Confirm, no options or dry-run. Retired endpoint stays resident for late requests.")
OZ_OP(45, "Datasets", "dataset.share", "share", 1, "Dataset", "", "Unavailable on AROS: no native NFS or SMB export provider is installed. Dataset share properties alone do not export a filesystem. No request is submitted and no storage is changed.")
OZ_OP(46, "Datasets", "dataset.unshare", "unshare", 1, "Dataset", "", "Unavailable on AROS: no native NFS or SMB export provider is installed. The CLI also reports this capability absence explicitly. No request is submitted and no storage is changed.")
OZ_OP(47, "Datasets", "dataset.upgrade", "upgrade", 1, "Filesystem", "", "Irreversibly upgrade one ZPL filesystem version using installed C:zfs with your identity. Recursive includes descendants. Empty options select current version 5; version=1..5 selects an explicit version (upstream refuses downgrade). Root and confirmation required; no force/dry-run. This does not upgrade the pool format.")
OZ_OP(48, "Datasets", "dataset.rewrite", "rewrite", 1, "Native file / directory", "", "Rewrite allocated blocks through installed C:zfs and the mounted AROS ZPL handler; logical data and holes are retained. Recursive traverses a directory. Options: offset=bytes;length=bytes;physical=on|off;verbose=on|off;xdev=on|off (xdev requires Recursive). physical=on preserves logical birth time and requires feature@physical_rewrite, reducing older-software compatibility. Confirm; no force/dry-run/argument.")
OZ_OP(49, "Datasets", "dataset.wait", "wait", 0, "Filesystem", "", "Wait for upstream filesystem deletion activity using C:zfs with your identity. Options: activities=deleteq, or empty for all. No other arguments or flags. Closing Manager waits for completion; this does not certify pool health.")
OZ_OP(50, "Snapshots", "snapshot.snapshot", "snapshot", 1, "Dataset@snapshot", "", "Authenticated upstream snapshot creation. Recursive creates the same snapshot name on the dataset and descendants atomically. Requires snapshot permission on every selected dataset and a writable pool. Confirm; no options, force or dry-run. Success means the snapshot transaction completed.")
OZ_OP(51, "Snapshots", "snapshot.bookmark", "bookmark", 1, "Source snapshot/bookmark", "Destination dataset#name", "Authenticated upstream bookmark creation or copy. Requires bookmark on destination filesystem. Confirm; no options/recursive/dry-run. Dataset list bookmarks=on lists bookmarks; destroy accepts dataset#name.")
OZ_OP(52, "Snapshots", "snapshot.clone", "clone", 1, "Source snapshot", "Destination dataset", "Authenticated upstream clone in the same pool. Requires clone on source, create/mount on parent. Optional semicolon-separated property=value pairs (up to 16) use installed C:zfs with your identity and upstream property validation. Confirm; no force, recursion, dry-run, implicit parents or automatic mount. Query destination after failure; do not blindly retry.")
OZ_OP(53, "Snapshots", "snapshot.promote", "promote", 1, "Clone dataset", "", "Authenticated upstream clone promotion. Requires promote on clone and origin, mount on clone. Full native service supports mounted filesystems; unmount origin snapshots first. Confirm, no options/dry-run. Collisions are reported, never destroyed.")
OZ_OP(54, "Snapshots", "snapshot.rollback", "rollback", 1, "Dataset@snapshot", "", "Authenticated rollback discards changes after the named latest snapshot. Rollback permission required. Full native service supports mounted filesystems; confirm, no recursive/force/options/dry-run or implicit snapshot destruction.")
OZ_OP(55, "Snapshots", "snapshot.hold", "hold", 1, "Dataset@snapshot", "Hold tag", "Authenticated persistent upstream snapshot hold. Recursive applies the same tag atomically to existing same-name snapshots on the dataset and descendants; hold permission is required on every selected snapshot. Confirm; no temporary/options/dry-run.")
OZ_OP(56, "Snapshots", "snapshot.release", "release", 1, "Dataset@snapshot", "Hold tag", "Authenticated upstream hold release. Recursive preflights the tag and release permission on every existing same-name snapshot, then removes the full set atomically. Confirm; no options/dry-run.")
OZ_OP(57, "Snapshots", "snapshot.holds", "holds", 0, "Dataset@snapshot", "", "List persistent upstream hold tags and creation timestamps. Recursive lists the same snapshot name on the dataset and descendants. Paginated live view; no options.")
OZ_OP(58, "Snapshots", "snapshot.diff", "diff", 0, "Dataset@snapshot", "To snapshot/filesystem (optional)", "Options: classify=on;scripted=on;timestamps=on;unescape=on. Empty destination compares the live filesystem.")
OZ_OP(59, "Snapshots", "snapshot.redact", "redact", 1, "Dataset@snapshot", "Bookmark name", "Create redaction bookmark, not erase source. Root and confirmation required. Options: snapshots=full@snap,full@snap (1-32, no commas in names). No force or dry-run. Send must explicitly select this bookmark.")
OZ_OP(60, "Replication", "replication.send", "send", 1, "Dataset@snapshot", "Native output file", "New or existing empty output only. Options: from=snapshot/bookmark; redact=short-bookmark-name; compressed=on/off; large-blocks=on/off; embedded=on/off; raw=on/off. Or resume=TOKEN with from= matching its incremental base; no format switches or redact override. Redacted resume resolves a completed matching bookmark. A redacted incremental base requires from=bookmark matching the token's GUID and redaction set. Redaction does not erase source data.")
OZ_OP(61, "Replication", "replication.receive", "receive", 1, "Dataset@snapshot", "Native stream file", "Full native service supports mounted filesystem receive. Force may discard local changes; explicit confirmation required. resumable=on preserves interrupted state; off is default. Get receive_resume_token in Datasets/get; use resume=TOKEN in Replication/send for continuation.")
OZ_OP(62, "Encryption", "encryption.load-key", "load-key", 1, "Encryption root", "Key file", "Load from an authorized AROS file: raw requires 32 bytes; hex requires 64 hex digits; passphrase uses the first line. Text strips LF only. Format comes from the dataset. Requires load-key permission. Enter a file path, never key bytes. Confirm; no options, force or dry-run.")
OZ_OP(63, "Encryption", "encryption.unload-key", "unload-key", 1, "Encryption root", "", "Unload the in-memory key. Requires load-key permission. Unmount dependent filesystems first. Also supported on read-only pools. Confirm; no options, force or dry-run.")
OZ_OP(64, "Encryption", "encryption.change-key", "change-key", 1, "Encryption root", "New key file", "Replace a loaded wrapping key from an authorized AROS file, retaining format and location. Passphrases require 8-512 bytes on the first line. Or set inherit=on with no key file to use the encrypted parent's key; both keys must be loaded. Requires change-key permission, writable pool and confirmation. No force or dry-run. Keep the replacement or parent key: the old key stops working.")
OZ_OP(65, "Permissions", "permission.allow", "allow", 1, "Dataset / zvol", "Principal / set:@name / creator", "Principal: user:ID, group:ID, everyone; options permissions=create,mount,@set;scope=local/descendants/both (default both). set:@name defines a permission set; creator grants rights on newly created datasets (omit scope for both). Confirm; no force/dry-run/recursive.")
OZ_OP(66, "Permissions", "permission.unallow", "unallow", 1, "Dataset / zvol", "Principal / set:@name / creator", "Revoke permissions=LIST or all=on, never both. Scope defaults both. Recursive visits children then target and checks authority on each; failure may leave partial changes, reported with completed count. Creator changes affect future creations. Confirm; no force/dry-run.")
OZ_OP(79, "Permissions", "permission.list", "list grants", 0, "Dataset / zvol", "", "List stored upstream grants, including ancestor records. Rows show principal, scope, permission and source dataset, not computed effective rights. Next page reads live state; restart if grants change. No flags or options.")
OZ_OP(67, "Permissions", "permission.userspace", "userspace", 0, "Filesystem", "Metric", "User accounting: used (default), quota, objects, objquota. Numeric IDs/domain; live pages. Turn all flags off. Upstream delegation required.")
OZ_OP(68, "Permissions", "permission.groupspace", "groupspace", 0, "Filesystem", "Metric", "Group accounting: used (default), quota, objects, objquota. Numeric IDs/domain; live pages. Turn all flags off. Upstream delegation required.")
OZ_OP(69, "Permissions", "permission.projectspace", "projectspace", 0, "Filesystem", "Metric", "Project accounting: used (default), quota, objects, objquota. Numeric IDs/domain; live pages. Turn all flags off. Upstream delegation required.")
OZ_OP(70, "Permissions", "permission.project", "project", 1, "Native file / directory", "list / set / clear / check", "Uses installed C:zfs with your identity, no shell. Options: id=NUMBER;inherit=on (set), keep=on (clear), directory=on. Recursive supported; no force/dry-run/raw/resumable. Set requires ID. Check reports mismatches; exit 0 alone does not mean none. Output limited to 4 KiB; failures may follow partial changes.")
OZ_OP(71, "Permissions", "permission.jail", "jail", 1, "Dataset / zvol", "FreeBSD jail", "Not applicable on AROS: this is a FreeBSD jail namespace operation and AROS has one global filesystem namespace. No request is submitted and no storage is changed.")
OZ_OP(72, "Permissions", "permission.unjail", "unjail", 1, "Dataset / zvol", "FreeBSD jail", "Not applicable on AROS: this is a FreeBSD jail namespace operation and AROS has one global filesystem namespace. No request is submitted and no storage is changed.")
OZ_OP(73, "Permissions", "permission.zone", "zone", 1, "Dataset / zvol", "Linux namespace file", "Not applicable on AROS: this is a Linux user-namespace operation and AROS has one global filesystem namespace. No request is submitted and no storage is changed.")
OZ_OP(74, "Permissions", "permission.unzone", "unzone", 1, "Dataset / zvol", "Linux namespace file", "Not applicable on AROS: this is a Linux user-namespace operation and AROS has one global filesystem namespace. No request is submitted and no storage is changed.")
OZ_OP(75, "Advanced", "advanced.program", "program", 1, "Pool", "Lua file", "Root only; confirm trusted Lua file. Options: sync=on|off;instructions=N;memory=bytes;json=on|off;arg=value (repeat, no semicolons). Upstream execution limits apply. Not a rollback sandbox.")
OZ_OP(76, "Advanced", "advanced.jobs", "requests", 0, "", "", "List your retained admission tickets and in-flight service workers (system sees all). Released/drained requests disappear. Use cancel-job for queued tickets only. Upstream scrub/resilver progress is in pool status. No fields or flags, including dry-run.")
OZ_OP(77, "Advanced", "advanced.cancel-job", "cancel-job", 1, "Request epoch:number", "", "Cancel a queued admission request owned by you (system may cancel any). Requires confirmation. Running/completed requests cannot be cancelled. No arguments, options, force or dry-run; cancelled results remain until released.")
OZ_OP(78, "Replication", "replication.abort-receive", "abort-receive", 1, "Dataset", "", "Discard saved interrupted receive state. An incomplete NEW filesystem is removed; an incremental target retains its original head and snapshots. Requires destroy/mount permission. Unmount first. Confirm; no options, force or dry-run.")
OZ_OP(80, "Pools", "vdev.get", "get vdev property", 0, "Pool name", "Member GUID (decimal)", "Read one exact vdev property, or enter all in Properties / options for live pagination across applicable registered and dynamic user properties. Use the member GUID from pool status. property-long rows require an exact query. No flags.")
OZ_OP(81, "Pools", "vdev.set", "set vdev property", 1, "Pool name", "Member GUID (decimal)", "Set one property=value using upstream zpool and your identity. Confirm; no force, recursion or dry-run. Native device path changes require the current member at an admitted destination; offline it before moving to a different extent. It stays offline until you online it. Not a replace operation; matching labels do not prove a stale copy is current. Live file path changes are unsupported. Query afterward, including after failure; do not blindly retry.")
