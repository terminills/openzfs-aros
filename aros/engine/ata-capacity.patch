+static UBYTE scsi_readcapacity16(struct ata_Unit *unit, struct SCSICmd *cmd, ULONG *outlen)
+{
+    UBYTE *c = cmd->scsi_Command, *out = (UBYTE *)cmd->scsi_Data;
+    UQUAD blocks = unit->au_Capacity48 ? unit->au_Capacity48 : unit->au_Capacity;
+    if (cmd->scsi_CmdLength != 16 || c[1] != 0x10 || c[14] != 0 ||
+        !blocks || !out || cmd->scsi_Length < 32 || rl(c + 10) < 32)
+        return 0xff;
+    /* PMI=0 requires a zero requested LBA. */
+    for (unsigned i = 2; i < 10; i++)
+        if (c[i]) return 0xff;
+    for (unsigned i = 0; i < 32; i++) out[i] = 0;
+    UQUAD last = blocks - 1;
+    wl(out, (ULONG)(last >> 32));
+    wl(out + 4, (ULONG)last);
+    wl(out + 8, 1UL << unit->au_SectorShift);
+    *outlen = 32;
+    return 0;
+}
