+static UBYTE scsi_readcapacity16(struct ata_Unit *unit, struct SCSICmd *cmd, ULONG *outlen)
+{
+    UBYTE *c = cmd->scsi_Command, *out = (UBYTE *)cmd->scsi_Data, response[32] = {0};
+    UQUAD blocks = unit->au_Capacity48 ? unit->au_Capacity48 : unit->au_Capacity;
+    if (cmd->scsi_CmdLength != 16 || c[1] != 0x10 || c[14] != 0 ||
+        !blocks || !(cmd->scsi_Flags & SCSIF_READ))
+        return 0xff;
+    ULONG allocation = rl(c + 10), count = allocation < 32 ? allocation : 32;
+    if (cmd->scsi_Length < count || (count && !out)) return 0xff;
+    /* PMI=0 requires a zero requested LBA. */
+    for (unsigned i = 2; i < 10; i++)
+        if (c[i]) return 0xff;
+    UQUAD last = blocks - 1;
+    wl(response, (ULONG)(last >> 32));
+    wl(response + 4, (ULONG)last);
+    wl(response + 8, 1UL << unit->au_SectorShift);
+    /* Allocation length truncates the response, not the reported capacity. */
+    for (ULONG i = 0; i < count; i++) out[i] = response[i];
+    *outlen = count;
+    return 0;
+}
