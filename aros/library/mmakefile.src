include $(SRCDIR)/config/aros.cfg

ifneq ($(strip $(OPENZFS_DEPENDENCIES)),)
include $(OPENZFS_DEPENDENCIES)
endif

# The engine object is produced by the full source engine build. This target
# packages it as an AROS library, never into any client executable.
OPENZFS_ENGINE_OBJECT ?= $(GENDIR)/$(CURDIR)/../engine/full/full-engine.o
OPENZFS_SERVICE_BUILD ?= $(GENDIR)/$(CURDIR)/../engine/full
OPENZFS_NVPAIR_ARCHIVE ?= $(AROS_LIB)/libnvpair.a
OPENZFS_PTHREAD_ARCHIVE ?= $(AROS_LIB)/libpthread.a
OPENZFS_PTHREAD_INCLUDE ?= $(AROS_INCLUDES)
OPENZFS_CRYPTO_ARCHIVE ?= $(AROS_LIB)/libboringssl.a
OPENZFS_ZLIB_IMPORT ?= $(AROS_LIB)/libz1.a
OPENZFS_OBJCOPY ?= $(shell $(AROS_CC) -print-prog-name=objcopy)
OPENZFS_NM ?= $(shell $(AROS_CC) -print-prog-name=nm)
OZ_LIBRARY_OBJ := $(GENDIR)/$(CURDIR)
OZ_LIBRARY_INPUTS := $(OPENZFS_NVPAIR_ARCHIVE) $(OPENZFS_ZLIB_IMPORT) \
    $(OPENZFS_CRYPTO_ARCHIVE) $(OPENZFS_PTHREAD_ARCHIVE)
OZD_ROOT := $(SRCDIR)/$(CURDIR)/../..
OZD_DIR := $(OZ_LIBRARY_OBJ)/debugger
OZD_MAIN := cmd/zdb/zdb cmd/zdb/zdb_il lib/libzdb/libzdb
OZD_SUPPORT := lib/libnvpair/libnvpair lib/libzfs_core/libzfs_core \
    aros/cli/control-client aros/cli/stream-client aros/cli/native-device \
    aros/ui/admission-client
OZD_OBJECTS := $(addprefix $(OZD_DIR)/,$(addsuffix .o,$(OZD_MAIN) $(OZD_SUPPORT)))
OZD_FLAGS := $(CFLAGS) -O2 -g -fno-strict-aliasing -ffunction-sections -fdata-sections \
    -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -include $(OZD_ROOT)/aros/engine/config.h \
    -I$(OPENZFS_PTHREAD_INCLUDE) -I$(OPENZFS_CRYPTO_INCLUDE) \
    -I$(OZD_ROOT)/aros/cli/include -I$(OZD_ROOT)/aros/engine/include \
    -I$(OZD_ROOT)/lib/libspl/include -I$(OZD_ROOT)/lib/libspl/include/os/linux \
    -I$(OZD_ROOT)/include -I$(OZD_ROOT)/include/os/linux/zfs
OZD_LD := $(shell $(AROS_CC) -print-prog-name=ld)

$(addprefix $(OZD_DIR)/,$(addsuffix .o,$(OZD_MAIN))): OZD_FIRST := -I$(OZD_ROOT)/aros/zpl/include
$(addprefix $(OZD_DIR)/,$(addsuffix .o,$(OZD_MAIN))): OZD_EXTRA := -DLIB_ZPOOL_BUILD \
    -include sys/sysmacros.h \
    -include $(OZD_ROOT)/aros/zpl/context.h -I$(OZD_ROOT)/module/icp/include \
    -I$(OPENZFS_TIRPC_SOURCE)/tirpc

$(OZD_DIR)/%.o: $(OZD_ROOT)/%.c
	@$(MKDIR) $(dir $@)
	$(AROS_CC) $(TARGET_SYSROOT) $(OZD_FIRST) $(OZD_FLAGS) $(OZD_EXTRA) -MD -MP -MF $@.d -c $< -o $@

$(OZD_DIR)/support.o: $(addprefix $(OZD_DIR)/,$(addsuffix .o,$(OZD_SUPPORT)))
	$(OZD_LD) -r --gc-sections -u dump_nvlist -u libzfs_core_init -u libzfs_core_fini \
	    -u lzc_get_props -u zfs_dev_is_whole_disk $^ -o $@

$(OZ_LIBRARY_OBJ)/debugger.o: $(addprefix $(OZD_DIR)/,$(addsuffix .o,$(OZD_MAIN))) $(OZD_DIR)/support.o
	$(OZD_LD) -r $^ -o $(OZD_DIR)/combined.o
	$(OPENZFS_OBJCOPY) --redefine-sym main=oz_zdb_main $(OZD_DIR)/combined.o $@

%include_deps depstargets="contrib-openzfs-library contrib-openzfs-library-quick" deps="$(OZD_OBJECTS:.o=.o.d)"

.PHONY: openzfs-engine-provenance
openzfs-engine-provenance:
	@test -n "$(OPENZFS_ENGINE_OBJECT)" -a -n "$(OPENZFS_SERVICE_BUILD)" || \
	    { echo 'Set OPENZFS_ENGINE_OBJECT and OPENZFS_SERVICE_BUILD to a full normal engine build'; exit 1; }
	@bash $(SRCDIR)/$(CURDIR)/verify-engine.sh "$(OPENZFS_ENGINE_OBJECT)" "$(OPENZFS_SERVICE_BUILD)" "$(OPENZFS_NM)"

$(OZ_LIBRARY_OBJ)/engine.o: $(OPENZFS_ENGINE_OBJECT) | openzfs-engine-provenance
	@$(MKDIR) $(dir $@)
	"$(OPENZFS_OBJCOPY)" --redefine-sym main=oz_service_main $< $@

# genmodule creates resident startup/end records and the public function ABI.
# USER_OBJS supplies only the engine and its matching archive dependencies.
USER_OBJS := $(OZ_LIBRARY_OBJ)/engine.o $(OZ_LIBRARY_OBJ)/debugger.o $(OZ_LIBRARY_INPUTS)
USER_LDFLAGS := -nix
#MM contrib-openzfs-library : includes linklibs contrib-openzfs-engine contrib-openzfs-nvpair
%build_module mmake=contrib-openzfs-library \
    modname=openzfs modtype=library conffile=openzfs.conf \
    files="engine-library" uselibs="m" stripdebug=no

USER_OBJS :=
USER_LDFLAGS :=
#MM contrib-openzfs-service : contrib-openzfs-library-includes
%build_prog mmake=contrib-openzfs-service progname=OpenZFSServiceNative \
    files="service-launcher" \
    cflags="$(CFLAGS) -I$(OZ_LIBRARY_OBJ)/openzfs/include" \
    objdir="$(OZ_LIBRARY_OBJ)/launcher" targetdir="$(AROS_C)"

$(OZ_LIBRARY_OBJ)/launcher/service-launcher.o: $(OZ_LIBRARY_OBJ)/openzfs/include/proto/openzfs.h

#MM contrib-openzfs-zdb : contrib-openzfs-library-includes
%build_prog mmake=contrib-openzfs-zdb progname=zdb \
    files="zdb-launcher" \
    cflags="$(CFLAGS) -I$(OZ_LIBRARY_OBJ)/openzfs/include" \
    objdir="$(OZ_LIBRARY_OBJ)/zdb-launcher" targetdir="$(AROS_C)"

$(OZ_LIBRARY_OBJ)/zdb-launcher/zdb-launcher.o: $(OZ_LIBRARY_OBJ)/openzfs/include/proto/openzfs.h

%common
