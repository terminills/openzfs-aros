diff --git a/aros/ui/build-manager-native.sh b/aros/ui/build-manager-native.sh
index 8c32361..57b08e3 100644
--- a/aros/ui/build-manager-native.sh
+++ b/aros/ui/build-manager-native.sh
@@ -5,13 +5,29 @@ cd "$repo"
 : "${AROS_SDK:?set AROS_SDK to the SDK matching the target runtime (hosted and PC/SMP are not interchangeable)}"
 sdk=$AROS_SDK
 cc=${AROS_CC:-/opt/aros-workspace/aros-adt-crosstools/x86_64-aros-gcc}
-pthread=${AROS_PRIVATE_PTHREAD:-$repo/build-aros/pthread-consistent.s3r1CHla/libpthread.a}
-pthread_include=${AROS_PTHREAD_INCLUDE:-$repo/build-aros/pthread-consistent.s3r1CHla/source}
+pthread_backend=${AROS_PTHREAD_BACKEND:-private}
+case "$pthread_backend" in
+    sdk)
+        if [[ -n ${AROS_PRIVATE_PTHREAD:-}${AROS_PTHREAD_INCLUDE:-} ]]; then
+            echo 'SDK pthread mode cannot be combined with private pthread inputs' >&2
+            exit 1
+        fi
+        pthread="$sdk/lib/libpthread.a"
+        pthread_include="$sdk/include"
+        test -f "$pthread"
+        test -f "$pthread_include/pthread.h"
+        ;;
+    private)
+        pthread=${AROS_PRIVATE_PTHREAD:-$repo/build-aros/pthread-consistent.s3r1CHla/libpthread.a}
+        pthread_include=${AROS_PTHREAD_INCLUDE:-$repo/build-aros/pthread-consistent.s3r1CHla/source}
+        cmp "$(dirname "$pthread")/source/pthread.h" "$pthread_include/pthread.h"
+        ;;
+    *) echo "Unsupported pthread backend: $pthread_backend" >&2; exit 1 ;;
+esac
 output=${1:-build-aros/OpenZFSManagerNative}
-cmp "$(dirname "$pthread")/source/pthread.h" "$pthread_include/pthread.h"
 mkdir -p "$(dirname "$output")"
 "$cc" --version >"$output.compiler.txt"
-printf 'sdk=%s\npthread=%s\npthread_include=%s\n' "$sdk" "$pthread" "$pthread_include" >"$output.target.txt"
+printf 'sdk=%s\npthread=%s\npthread_include=%s\npthread_backend=%s\n' "$sdk" "$pthread" "$pthread_include" "$pthread_backend" >"$output.target.txt"
 # Preserve the actual compile-time layout and startup archive identity. AROS
 # SMP SDK generations can differ despite sharing the x86_64 target triple.
 "$cc" --sysroot="$sdk" -B"$sdk/lib/" -I"$pthread_include" -S \
diff --git a/aros/ui/test-qemu-no-service.sh b/aros/ui/test-qemu-no-service.sh
index 71e88d9..b811770 100644
--- a/aros/ui/test-qemu-no-service.sh
+++ b/aros/ui/test-qemu-no-service.sh
@@ -30,13 +30,17 @@ xorriso -indev "$base" -outdev "$run/test.iso" \
     -map "$run/Startup-Sequence" /S/Startup-Sequence \
     -map "$run/OpenZFSManagerNative" /Tools/OpenZFSManagerNative \
     "${extra_maps[@]}" \
-    -boot_image any discard -boot_image grub bin_path=/boot/grub/i386-pc/eltorito.img \
+    -boot_image any discard -boot_image any system_area=/dev/zero \
+    -boot_image grub bin_path=/boot/grub/i386-pc/eltorito.img \
     -boot_image grub boot_info_table=on -boot_image grub grub2_boot_info=on >"$run/pack.log" 2>&1
-qemu-system-x86_64 -name "openzfs-manager-startup-$$" -machine pc,accel=kvm \
+(
+cd "$run"
+exec qemu-system-x86_64 -name "openzfs-manager-startup-$$" -machine pc,accel=kvm \
     -cpu host -smp 2 -m 2048 -drive "file=$run/test.iso,media=cdrom,if=ide,index=2,readonly=on" \
     -vga std -display none -nic none -boot d -no-reboot -no-shutdown \
     -device qemu-xhci -device usb-tablet -serial "file:$run/serial.log" \
-    -monitor "unix:$run/monitor,server=on,wait=off" >"$run/qemu.log" 2>&1 &
+    -monitor "unix:monitor,server=on,wait=off"
+) >"$run/qemu.log" 2>&1 &
 pid=$!
 printf '%s\n' "$pid" >"$run/qemu.pid"
 trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true' EXIT
