     CHECK(dmu_objset_userspace_present(fs->z_os)?0:EIO);
@@ -561,7 +563,9 @@ static int legacy_accounting_test(nvlist_t *root)
     CHECK(memcmp(actual,payload,sizeof(actual))?EIO:0);
