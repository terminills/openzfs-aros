     while(*s)RawPutChar(*s++);
     return 0;
 }
@@ -1520,7 +1524,8 @@ static int run(void)
     CHECK(file_scope_test(dir));
     CHECK(session_files_test());
 #ifdef OZ_NATIVE_DISPATCHER
-    CHECK(legacy_accounting_test(root));
