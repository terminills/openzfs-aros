diff --git a/aros/engine/build-management.sh b/aros/engine/build-management.sh
index 63037fa..0692655 100644
--- a/aros/engine/build-management.sh
+++ b/aros/engine/build-management.sh
@@ -8,6 +8,14 @@ sdk_flags=()
 test_flags=()
 if [[ ${AROS_FULL_DISPATCHER:-0} == 1 ]];then test_flags+=(-DOZ_NATIVE_DISPATCHER);fi
 if [[ -n ${AROS_SDK:-} ]];then sdk_flags=(--sysroot="$AROS_SDK" -B"$AROS_SDK/lib/");fi
+if [[ ${AROS_PTHREAD_BACKEND:-private} == sdk ]]; then
+    [[ -z ${AROS_PRIVATE_PTHREAD:-} ]]
+    [[ ${AROS_PTHREAD_INCLUDE:-} == "${AROS_SDK:?}/include" ]]
+    pthread_archive="$AROS_SDK/lib/libpthread.a"
+else
+    pthread_archive=${AROS_PRIVATE_PTHREAD:?private pthread archive required}
+fi
+[[ -f $pthread_archive ]]
 # Requires the verified full engine and nvpair object builds. Diagnostic static
 # packaging only; the production shared engine and DOS handler are separate work.
 bash aros/engine/link-engine-test.sh aros/ui/service.c
@@ -19,7 +27,11 @@ cp "${AROS_ENGINE_OBJECT_DIR:-build-aros/engine}/engine-metadata.h" \
     -o "$output_dir/OpenZFSWriteTest"
 "$cc" "${sdk_flags[@]}" -Wall -Wextra -O2 aros/ui/api.c aros/engine/mount-test.c \
     -o "$output_dir/OpenZFSMountTest"
-bash aros/ui/build-manager-native.sh "$output_dir/OpenZFSManagerNative"
+if [[ ${AROS_PTHREAD_BACKEND:-private} == sdk ]]; then
+    env -u AROS_PTHREAD_INCLUDE bash aros/ui/build-manager-native.sh "$output_dir/OpenZFSManagerNative"
+else
+    bash aros/ui/build-manager-native.sh "$output_dir/OpenZFSManagerNative"
+fi
 test_objects=()
 if [[ -n ${AROS_PUBLIC_INIT_OBJECT:-} ]];then
     test_flags+=(-DOZ_TEST_UPSTREAM_INIT)
@@ -43,7 +55,7 @@ if [[ ${AROS_FULL_DISPATCHER:-0} == 1 ]];then
         "$output_dir/client/lib_libzfs_core_libzfs_core.c.o"
         "$output_dir/client/lib_libnvpair_libnvpair.c.o"
         "${AROS_NVPAIR_ARCHIVE:-build-aros/libnvpair-adt-consistent.a}"
-        "${AROS_PRIVATE_PTHREAD:-build-aros/pthread-consistent.s3r1CHla/libpthread.a}")
+        "$pthread_archive")
 fi
 # Keep the standalone acceptance client aligned with
 # OPENZFS_PUBLIC_TEST_FILES in mmakefile.src: its current fixtures exercise
@@ -56,7 +68,7 @@ fi
     aros/ui/startup-settings.c aros/ui/startup-settings-file.c \
     aros/ui/preferences.c aros/ui/preferences-file.c aros/engine/hostid-record.c \
     aros/cli/version.c aros/engine/public-service-test.c \
-    "${test_objects[@]}" "${AROS_PRIVATE_PTHREAD:?private pthread archive required}" \
+    "${test_objects[@]}" "$pthread_archive" \
     -liffparse -o "$output_dir/OpenZFSPublicServiceTest"
 printf 'service_test_modes=%s\nfull_dispatcher=%s\nstatus_trace=%s\n' \
     "${AROS_SERVICE_TEST_MODES:-0}" "${AROS_FULL_DISPATCHER:-0}" "${AROS_STATUS_TRACE:-0}" >"$output_dir/service-build-options.txt"
diff --git a/aros/engine/build-source.sh b/aros/engine/build-source.sh
index 6a6bbca..1f8abd1 100644
--- a/aros/engine/build-source.sh
+++ b/aros/engine/build-source.sh
@@ -4,14 +4,31 @@ set -euo pipefail
 repo=$(cd -- "$(dirname -- "$0")/../.." && pwd)
 cd "$repo"
 : "${AROS_SDK:?explicit ABI-matched AROS SDK required}"
-: "${AROS_PRIVATE_PTHREAD:?complete private pthread archive required}"
-: "${AROS_PTHREAD_INCLUDE:?matching private pthread headers required}"
-cmp "$(dirname "$AROS_PRIVATE_PTHREAD")/source/pthread.h" "$AROS_PTHREAD_INCLUDE/pthread.h"
+case ${AROS_PTHREAD_BACKEND:-private} in
+    sdk)
+        if [[ -n ${AROS_PRIVATE_PTHREAD:-}${AROS_PTHREAD_INCLUDE:-} ]]; then
+            echo 'SDK pthread mode cannot be combined with private pthread inputs' >&2
+            exit 1
+        fi
+        pthread_archive="$AROS_SDK/lib/libpthread.a"
+        export AROS_PTHREAD_INCLUDE="$AROS_SDK/include"
+        [[ -f $pthread_archive && -f $AROS_PTHREAD_INCLUDE/pthread.h ]]
+        ;;
+    private)
+        : "${AROS_PRIVATE_PTHREAD:?complete private pthread archive required}"
+        : "${AROS_PTHREAD_INCLUDE:?matching private pthread headers required}"
+        cmp "$(dirname "$AROS_PRIVATE_PTHREAD")/source/pthread.h" "$AROS_PTHREAD_INCLUDE/pthread.h"
+        pthread_archive=$AROS_PRIVATE_PTHREAD
+        ;;
+    *) echo 'Unsupported pthread backend' >&2; exit 1 ;;
+esac
 source "$repo/aros/engine/storage-preflight.sh"
 artifact_root=$(oz_artifact_root "$repo/build-aros" "${AROS_ARTIFACT_ROOT:-}")
 run=$(mktemp -d "$artifact_root/source-engine.XXXXXXXX")
 echo "Evidence: $run"
 mkdir "$run/engine" "$run/include" "$run/logs"
+sha256sum "$pthread_archive" "$AROS_PTHREAD_INCLUDE/pthread.h" > "$run/pthread-inputs.sha256"
+printf 'pthread_backend=%s\n' "${AROS_PTHREAD_BACKEND:-private}" > "$run/pthread-backend.txt"
 if [[ -z ${AROS_NVPAIR_ARCHIVE:-} ]];then
     export AROS_NVPAIR_ARCHIVE="$run/nvpair/libnvpair.a"
     AROS_NVPAIR_OUTPUT_DIR="$run/nvpair" AROS_NVPAIR_OBJECT_DIR="$run/nvpair/objects" \
@@ -50,5 +67,6 @@ done <"$run/sources.txt"
 [[ $failed == 0 ]]
 bash aros/engine/build-management.sh >"$run/link.log" 2>&1
 sha256sum "$run/service/OpenZFSServiceNative" "$run/service/OpenZFSManagerNative" \
-    "$AROS_PRIVATE_PTHREAD" "$AROS_NVPAIR_ARCHIVE" >"$run/binaries.sha256"
+    "$pthread_archive" "$AROS_NVPAIR_ARCHIVE" >"$run/binaries.sha256"
+sha256sum -c "$run/pthread-inputs.sha256" > "$run/pthread-after-check.log"
 echo "PASS fresh-source engine and Manager build: $run"
