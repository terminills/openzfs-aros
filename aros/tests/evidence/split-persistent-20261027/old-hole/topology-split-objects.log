		org.openzfs:blake3 = BLAKE3 hash algorithm.
		com.datto:resilver_defer = Support for deferring new resilvers when one is already running.
		com.delphix:embedded_data = Blocks which compress very well use even less space.
		org.zfsonlinux:longname = support filename up to 1024 bytes
		com.delphix:livelist = Improved clone deletion performance.
		com.fudosecurity:block_cloning = Support for block cloning via Block Reference Table.
		org.openzfs:draid = Support for distributed spare RAID
		org.zfsonlinux:large_dnode = Variable on-disk size of dnodes.
		org.open-zfs:large_blocks = Support for blocks larger than 128KB.
		com.delphix:bookmarks = "zfs bookmark" command
		com.delphix:enabled_txg = Record txg at which a feature is enabled
		org.openzfs:zilsaxattr = Support for xattr=sa extended attribute logging in ZIL.
		com.klarasystems:large_microzap = Support for microzaps larger than 128KB.
		org.zfsonlinux:allocation_classes = Support for separate allocation classes.
		com.datto:encryption = Support for dataset level encryption
		com.klarasystems:fast_dedup = Support for advanced deduplication
		org.illumos:skein = Skein hash algorithm.
		com.delphix:empty_bpobj = Snapshots use less space.
		com.delphix:redaction_bookmarks = Support for bookmarks which store redaction lists for zfs redacted send/recv.
		org.zfsonlinux:project_quota = space/object accounting based on project ID.
		com.joyent:filesystem_limits = Filesystem and snapshot limits.
		com.delphix:obsolete_counts = Reduce memory used by removed devices when their blocks are freed or remapped.
		com.joyent:multi_vdev_crash_dump = Crash dumps to multiple vdev pools.
		com.delphix:extensible_dataset = Enhanced dataset functionality, used by other features.
		com.truenas:physical_rewrite = Support for preserving logical birth time during rewrite.
		com.delphix:log_spacemap = Log metaslab changes on a single spacemap and flush them periodically.
		com.delphix:redacted_datasets = Support for redacted datasets, produced by receiving a redacted zfs send stream.
		com.datto:bookmark_v2 = Support for larger bookmarks
		com.truenas:block_cloning_endian = Fixes BRT ZAP endianness on new pools.
		org.openzfs:raidz_expansion = Support for raidz expansion
		org.illumos:lz4_compress = LZ4 compression algorithm support.
		org.freebsd:zstd_compress = zstd compression algorithm support.
		com.delphix:spacemap_histogram = Spacemaps maintain space histograms.
		com.delphix:hole_birth = Retain hole birth txg for more precise zfs send
		org.zfsonlinux:userobj_accounting = User/Group object accounting.
		org.illumos:sha512 = SHA-512/256 hash algorithm.
		com.klarasystems:dynamic_gang_header = Support for dynamically sized gang headers
		com.delphix:device_removal = Top-level vdevs can be removed, reducing logical pool size.
		com.delphix:async_destroy = Destroy filesystems asynchronously.
		com.delphix:bookmark_written = Additional accounting, enabling the written#<bookmark> property (space written since a bookmark), and estimates of send stream sizes for incrementals from bookmarks.
		org.openzfs:device_rebuild = Support for sequential mirror/dRAID device rebuilds
		com.delphix:redaction_list_spill = Support for increased number of redaction_snapshot arguments in zfs redact.
		com.delphix:zpool_checkpoint = Pool state can be checkpointed, allowing rewind later.
		com.delphix:spacemap_v2 = Space maps representing large segments are more efficient.
		org.illumos:edonr = Edon-R hash algorithm.
		com.delphix:head_errlog = Support for per-dataset on-disk error logs.
		com.klarasystems:vdev_zaps_v2 = Support for root vdev ZAP.

