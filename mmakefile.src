# OpenZFS AROS native tools. Scanned as part of an AROS Contrib source tree.
include $(SRCDIR)/config/aros.cfg

# Keep target-specific SDK and compiler selection in the enclosing AROS build.
# A private pthread implementation can be selected explicitly for older SDKs.
OPENZFS_PTHREAD_INCLUDE ?= $(AROS_INCLUDES)
OPENZFS_PTHREAD_LIBDIR ?= $(AROS_LIB)
OPENZFS_TOOLSDIR ?= $(AROS_TOOLS)

OPENZFS_MANAGER_FILES := aros/ui/api aros/ui/admission-client \
    aros/ui/admission-worker aros/ui/manager aros/ui/project-worker \
    aros/cli/process aros/cli/arguments aros/cli/output \
    aros/ui/preferences aros/ui/preferences-file \
    aros/ui/startup-settings aros/ui/startup-settings-file \
    aros/ui/hostid-settings aros/engine/hostid-record

#MM contrib-openzfs-tools : contrib-openzfs-manager contrib-openzfs-hostidentity contrib-openzfs-runtimecheck contrib-openzfs-device contrib-openzfs-exechelper
#MM contrib-openzfs : contrib-openzfs-tools contrib-openzfs-cli contrib-openzfs-handler contrib-openzfs-library contrib-openzfs-service
.PHONY: contrib-openzfs contrib-openzfs-tools contrib-openzfs-cli
contrib-openzfs contrib-openzfs-tools contrib-openzfs-cli:
	@:
#MM contrib-openzfs-manager : includes linklibs
#MM contrib-openzfs-hostidentity : includes linklibs
#MM contrib-openzfs-runtimecheck : includes linklibs contrib-openzfs-exechelper
#MM contrib-openzfs-device : includes linklibs
#MM contrib-openzfs-exechelper : includes linklibs

%build_prog mmake=contrib-openzfs-exechelper progname=ExecHelper \
    files="aros/cli/exec-helper" usetree=yes nix=yes \
    targetdir="$(OPENZFS_TOOLSDIR)/OpenZFS"

%build_prog mmake=contrib-openzfs-manager progname=OpenZFSManagerNative \
    files="$(OPENZFS_MANAGER_FILES)" usetree=yes \
    cflags="$(CFLAGS) -I$(OPENZFS_PTHREAD_INCLUDE)" \
    libdir="$(OPENZFS_PTHREAD_LIBDIR)" \
    uselibs="pthread muimaster intuition utility iffparse" \
    targetdir="$(OPENZFS_TOOLSDIR)"

%build_prog mmake=contrib-openzfs-hostidentity progname=OpenZFSHostIdentity \
    files="aros/ui/hostid-cli aros/ui/hostid-settings aros/engine/hostid-record aros/ui/preferences aros/ui/preferences-file" \
    usetree=yes uselibs="iffparse" targetdir="$(AROS_C)"

%build_prog mmake=contrib-openzfs-runtimecheck progname=OpenZFSRuntimeCheck \
    files="aros/cli/runtime-check aros/cli/process aros/cli/arguments aros/cli/output" \
    usetree=yes nix=yes targetdir="$(AROS_C)" \
    objdir="$(GENDIR)/$(CURDIR)/runtimecheck"

# This command installs the resident zvol device; it is not a generated module.
%build_prog mmake=contrib-openzfs-device progname=OpenZFSDevice \
    files="aros/device/zvol-device aros/ui/admission-client" \
    usetree=yes targetdir="$(AROS_C)"

include $(SRCDIR)/$(CURDIR)/aros/cli/build-system.mk

#MM contrib-openzfs-cli : contrib-openzfs-zfs contrib-openzfs-zpool contrib-openzfs-startup contrib-openzfs-startupmount contrib-openzfs-exechelper
#MM contrib-openzfs-zfs : includes linklibs contrib-openzfs-nvpair contrib-openzfs-exechelper
#MM contrib-openzfs-zpool : includes linklibs contrib-openzfs-nvpair contrib-openzfs-exechelper
#MM contrib-openzfs-startup : includes linklibs contrib-openzfs-nvpair
#MM contrib-openzfs-startupmount : includes linklibs contrib-openzfs-nvpair

%rule_compile_multi mmake=contrib-openzfs-cli-vdev \
    basenames="cmd/zpool/zpool_vdev" targetdir="$(OZ_CLI_OBJ)" \
    usetree=yes cflags="$(OZ_CLI_FLAGS)"

%build_prog mmake=contrib-openzfs-zfs progname=zfs \
    files="cmd/zfs/zfs_main cmd/zfs/zfs_iter cmd/zfs/zfs_project $(OZ_CLI_COMMON)" \
    objs="$(OZ_CLI_OBJ)/check-file-generic.o $(OPENZFS_PIPE2_OBJECT)" \
    usetree=yes nix=yes cflags="$(OZ_CLI_FLAGS)" ldflags="$(OZ_CLI_LINK)" \
    objdir="$(OZ_CLI_OBJ)" targetdir="$(AROS_C)"

%build_prog mmake=contrib-openzfs-zpool progname=zpool \
    files="cmd/zpool/zpool_main cmd/zpool/zpool_iter cmd/zpool/zpool_util $(OZ_CLI_COMMON)" \
    objs="$(OZ_CLI_OBJ)/cmd/zpool/zpool_vdev.o $(OPENZFS_PIPE2_OBJECT)" \
    usetree=yes nix=yes cflags="$(OZ_CLI_FLAGS)" ldflags="$(OZ_CLI_LINK)" \
    objdir="$(OZ_CLI_OBJ)" targetdir="$(AROS_C)"

%rule_compile_multi mmake=contrib-openzfs-startup-support \
    basenames="aros/cli/startup-mount" targetdir="$(OZ_CLI_OBJ)/startup-library" \
    usetree=yes cflags="$(OZ_CLI_FLAGS) -DOZ_STARTUP_MOUNT_LIBRARY"

%build_prog mmake=contrib-openzfs-startupmount progname=OpenZFSStartupMount \
    files="aros/cli/startup-mount $(OZ_CLI_COMMON)" \
    objs="$(OZ_CLI_OBJ)/check-file-generic.o $(OPENZFS_PIPE2_OBJECT)" \
    usetree=yes nix=yes cflags="$(OZ_CLI_FLAGS)" ldflags="$(OZ_CLI_LINK)" \
    objdir="$(OZ_CLI_OBJ)" targetdir="$(AROS_C)"

%build_prog mmake=contrib-openzfs-startup progname=OpenZFSStartup \
    files="aros/cli/startup aros/ui/startup-import aros/ui/startup-settings aros/ui/startup-settings-file aros/ui/preferences aros/ui/preferences-file $(OZ_CLI_COMMON)" \
    objs="$(OZ_CLI_OBJ)/startup-library/aros/cli/startup-mount.o $(OZ_CLI_OBJ)/check-file-generic.o $(OPENZFS_PIPE2_OBJECT)" \
    usetree=yes nix=yes uselibs="iffparse" \
    cflags="$(OZ_CLI_FLAGS)" ldflags="$(OZ_CLI_LINK)" \
    objdir="$(OZ_CLI_OBJ)" targetdir="$(AROS_C)"

# Optional runtime acceptance client, not part of the installed production set.
#MM contrib-openzfs-public-test : includes linklibs contrib-openzfs-nvpair
OPENZFS_PUBLIC_TEST_FILES := aros/ui/api aros/ui/admission-client \
    aros/ui/project-worker \
    aros/cli/process aros/cli/arguments aros/cli/output \
    aros/ui/startup-settings aros/ui/startup-settings-file \
    aros/ui/preferences aros/ui/preferences-file aros/engine/hostid-record \
    aros/cli/version aros/platform/cpu aros/engine/public-service-test aros/cli/ioctl-public-test \
    aros/cli/control-client aros/cli/stream-client aros/cli/stream-channel \
    lib/libzfs_core/libzfs_core lib/libnvpair/libnvpair
OPENZFS_PUBLIC_TEST_OBJ := $(GENDIR)/$(CURDIR)/public-test
$(addprefix $(OPENZFS_PUBLIC_TEST_OBJ)/,$(addsuffix .o,$(OPENZFS_PUBLIC_TEST_FILES))) \
$(addprefix $(OPENZFS_PUBLIC_TEST_OBJ)/,$(addsuffix .d,$(OPENZFS_PUBLIC_TEST_FILES))): \
    $(OZ_CLI_OBJ)/metadata.h $(OZ_CLI_OBJ)/zfs_gitrev.h
%build_prog mmake=contrib-openzfs-public-test progname=OpenZFSPublicServiceTest \
    files="$(OPENZFS_PUBLIC_TEST_FILES)" usetree=yes \
    cflags="$(OZ_CLI_FLAGS) -DOZ_NATIVE_DISPATCHER -DOZ_NATIVE_ONEXIT -DOZ_TEST_NATIVE_CPU" \
    ldflags="$(OZ_CLI_LINK)" objdir="$(OPENZFS_PUBLIC_TEST_OBJ)" \
    targetdir="$(AROS_C)"

%common
